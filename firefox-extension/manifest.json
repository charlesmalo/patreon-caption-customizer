{
  "manifest_version": 3,
  "name": "Video Streaming Caption Customizer",
  "version": "2.6",
  "description": "Move, resize & recolor video captions/subtitles on streaming sites (Patreon, Vimeo, Streamable, hls.js/Shaka/Video.js players).",
  "browser_specific_settings": {
    "gecko": {
      "id": "video-streaming-caption-customizer@charlesmalo",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
