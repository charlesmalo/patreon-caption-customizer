{
  "manifest_version": 3,
  "name": "Patreon Caption Customizer",
  "version": "2.4",
  "description": "Move, resize and recolor Patreon captions/subtitles, adjust text + background opacity, and auto-scroll long captions.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.patreon.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
