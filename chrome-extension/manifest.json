{
  "manifest_version": 3,
  "name": "Video Streaming Caption Customizer",
  "version": "3.0.1",
  "description": "Move, resize & recolor video captions/subtitles on streaming sites including YouTube (Patreon, Vimeo, Streamable, hls.js/Shaka/Video.js players). Set persistent default looks in the dashboard.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Caption Customizer settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.patreon.com/*",
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.vimeo.com/*",
        "*://*.streamable.com/*",
        "*://*.dailymotion.com/*",
        "*://*.ted.com/*",
        "*://*.twitch.tv/*",
        "*://*.kick.com/*",
        "*://*.wistia.com/*",
        "*://*.wistia.net/*",
        "*://*.brightcove.net/*",
        "*://*.floatplane.com/*",
        "*://*.nebula.tv/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
